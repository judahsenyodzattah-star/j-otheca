# J’otheca staging environment — copy to `infra/.env` and fill. NEVER commit real values.
# Every entry is consumed by infra/docker-compose.yml (backend runs with profile `staging`).

# --- database (pgvector/pgvector:pg16) ---
POSTGRES_USER=jotheca
POSTGRES_PASSWORD=generate-a-strong-password
POSTGRES_DB=jotheca

# --- Phase A tenant-isolation runtime roles (see infra/db/provision-roles.sh) ---
# Secrets for the least-privilege roles provisioned into Postgres on first init. Generate strong values;
# NEVER commit real ones. jotheca_app = tenant plane (RLS-enforced), jotheca_readall = platform plane
# (BYPASSRLS, SELECT-only, audited), jotheca_migrate = Flyway/DDL principal.
JOTHECA_MIGRATE_PW=generate-a-strong-password
JOTHECA_APP_PW=generate-a-strong-password
JOTHECA_READALL_PW=generate-a-strong-password
# Restricted-role cutover switch. Leave false until the platform-plane routing (jotheca_readall reads;
# writes run as jotheca_app confined to the target library) is deployed; then set true AND point the
# runtime at jotheca_app:
APP_RESTRICTED_ROLE=false
# APP_RUNTIME_DB_USER=jotheca_app
# APP_RUNTIME_DB_PASSWORD=<same as JOTHECA_APP_PW>
# APP_FLYWAY_DB_USER=jotheca
# APP_PLATFORM_READ_DB_PASSWORD=<same as JOTHECA_READALL_PW>
# APP_RATE_LIMIT_TRUSTED_PROXIES=<ingress/load-balancer IP(s), comma-separated>

# --- API ---
# >= 48 chars; app refuses to boot on a weak/empty secret (JwtService fail-fast)
APP_JWT_SECRET=generate-48-plus-random-chars-xxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_BASE_URL=https://staging.jotheca.app
CORS_ORIGINS=https://staging-app.jotheca.app
SWAGGER_ENABLED=true
# AI_SEARCH_BACKEND=pgvector is fixed by the staging profile.
# Optional: AI_EMBEDDER=openai + AI_OPENAI_API_KEY=sk-...

# --- object storage (minio) ---
MINIO_ROOT_USER=jotheca
MINIO_ROOT_PASSWORD=generate-a-strong-password

# --- mail (compose ships mailpit for staging; swap for a real SMTP provider) ---
# MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD / MAIL_SMTP_AUTH / MAIL_STARTTLS
