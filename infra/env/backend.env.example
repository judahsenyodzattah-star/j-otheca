# Copy to .env and fill in. NEVER commit real secrets.
POSTGRES_USER=libranet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=libranet
# >= 48 chars, high entropy. Dev default in application-dev.yml is intentionally weak and profile-scoped.
APP_JWT_SECRET=change-me-generate-a-long-random-string
MINIO_ROOT_USER=libranet
MINIO_ROOT_PASSWORD=change-me
# Dev-only seed passwords (dev profile ignores these in CI)
SEED_SUPER_ADMIN_PASSWORD=Admin12345!
